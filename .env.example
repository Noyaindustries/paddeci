# Copiez ce fichier en .env pour le développement local (netlify dev le charge automatiquement).

NETLIFY_DATABASE_URL=

# Infinite Core V2 (Vercel) — obligatoire pour l'admin /admin/audits-padde
INFINITE_CORE_API_URL=https://www.infinitecore.net
# Identique à Vercel Production (Infinite Core) — sert à signer HMAC-SHA256 du corps JSON
PADDE_WEBHOOK_SECRET=

# Si Vercel Protection bloque les appels serveur Netlify → Vercel
VERCEL_PROTECTION_BYPASS=
